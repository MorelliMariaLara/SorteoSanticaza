@{
    ViewData["Title"] = "Admin";
    Layout = "_Layout";
}

<main class="section" style="max-width:28rem;min-height:100vh;display:flex;flex-direction:column;justify-content:center;">
    <h1 class="font-display" style="font-size:2rem;color:var(--accent);">Admin SANTICAZA</h1>
    <form asp-action="Login" method="post" style="margin-top:1.2rem;display:grid;gap:0.7rem;">
        @Html.AntiForgeryToken()
        <input class="field" type="password" name="password" placeholder="Password" required />
        @if (ViewBag.Error is string err)
        {
            <div class="alert">@err</div>
        }
        <button class="btn btn-accent" type="submit">Ingresar</button>
    </form>
</main>
