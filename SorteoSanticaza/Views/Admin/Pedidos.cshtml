@model List<AdminOrderRow>
@{
    ViewData["Title"] = "Admin · Pedidos";
    ViewData["AdminTab"] = "pedidos";
    var active = ViewBag.ActiveRaffle as RafflePublic;
}

<main class="section admin-page">
    <partial name="_AdminNav" />

    <div class="admin-toolbar">
        <div>
            <h1 class="font-display admin-title">Pedidos y ganadores</h1>
            <p class="admin-sub">
                @(active == null
                    ? "No hay sorteo activo."
                    : ("Sorteo activo: " + active.Title + " · " + active.SoldTickets + " vendidas"))
            </p>
        </div>
        <a class="btn btn-outline" asp-action="Pedidos">Actualizar</a>
    </div>

    <form asp-action="PublicarGanador" method="post" class="panel admin-section">
        @Html.AntiForgeryToken()
        <h2 class="admin-section-title">Publicar ganador</h2>
        <div class="form-grid">
            <div>
                <label class="label">Número ganador</label>
                <input class="field" name="ticketNumber" type="number" min="1" placeholder="Ej: 4521" required />
            </div>
            <div>
                <label class="label">Premio / etiqueta</label>
                <input class="field" name="prizeLabel" value="Premio principal" required />
            </div>
        </div>
        <button class="btn btn-accent" type="submit" style="margin-top:0.9rem;">Publicar ganador</button>
    </form>

    <div class="table-wrap" style="margin-top:1.4rem;">
        <table>
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th>Monto</th>
                    <th>Números</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>
                        <div><strong>@o.Name</strong></div>
                        <div style="color:var(--text-muted);font-size:0.8rem;">@o.Email · DNI @o.Dni</div>
                    </td>
                    <td style="text-transform:uppercase;font-size:0.75rem;">@o.Status</td>
                    <td>
                        @FormatHelper.FormatArs(o.AmountCents)
                        <div style="color:var(--text-muted);font-size:0.8rem;">@o.Chances chances</div>
                    </td>
                    <td style="color:var(--accent);">
                        @(string.IsNullOrWhiteSpace(o.TicketNumbers)
                            ? "—"
                            : string.Join(" ", o.TicketNumbers.Split(',').Select(n => "#" + FormatHelper.PadTicket(int.Parse(n)))))
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</main>
